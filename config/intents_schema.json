{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JarvisIntentsConfiguration",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["action_id", "templates"],
    "properties": {
      "action_id": {
        "type": "string",
        "minLength": 1
      },
      "action_args": {
        "type": "object"
      },
      "templates": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "priority_words": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false
  }
}