# AUTO-GENERATED by tools/gen_dataset.py — do not hand-edit.
# Regenerate with: python tools/gen_dataset.py (edit config/intents.json instead)
# Root: exactly matches training output schema {"actions": [...]}. No "reply"
# field -- this model only classifies/routes, a separate reply-only model
# handles spoken phrasing.
root ::= "{" ws "\"actions\"" ws ":" ws action-array ws "}"

# Array of actions (can be empty [] or contain objects)
action-array ::= "[" ws "]" | "[" ws action-object (ws "," ws action-object)* ws "]"

# Action object: action_id is mandatory and constrained to known intents,
# followed by zero or more optional fields
action-object ::= "{" ws "\"action_id\"" ws ":" ws action-id (ws "," ws action-field)* ws "}"

# Known action_id values, derived from config/intents.json
action-id ::=
    "\"alarm.control\"" |
    "\"alarm.create\"" |
    "\"calendar.create\"" |
    "\"calendar.read\"" |
    "\"light.set\"" |
    "\"mic.state\"" |
    "\"reminder.create\"" |
    "\"reminder.delete\"" |
    "\"reminder.list\"" |
    "\"spotify.control\"" |
    "\"state.change\"" |
    "\"state.daemon\"" |
    "\"system.discovery\"" |
    "\"system.restart_all\"" |
    "\"system.restart_module\"" |
    "\"system.show_logs\"" |
    "\"todo.create\"" |
    "\"todo.list\"" |
    "\"ui.fullscreen\"" |
    "\"ui.overlay\"" |
    "\"updates.check\"" |
    "\"updates.force_all\""

# Each optional field as a flat alternative (no parentheses)
action-field ::=
    "\"action\"" ws ":" ws action-value |
    "\"light_target\"" ws ":" ws string |
    "\"color\"" ws ":" ws string |
    "\"playlist_name\"" ws ":" ws string |
    "\"track_name\"" ws ":" ws string |
    "\"artist_name\"" ws ":" ws string |
    "\"search_query\"" ws ":" ws string |
    "\"task\"" ws ":" ws string |
    "\"time\"" ws ":" ws string |
    "\"time_str\"" ws ":" ws string |
    "\"event\"" ws ":" ws string |
    "\"target\"" ws ":" ws string |
    "\"target_str\"" ws ":" ws string |
    "\"lum\"" ws ":" ws number |
    "\"volume\"" ws ":" ws number

# Known "action" verb values, derived from config/intents.json action_args
action-value ::=
    "\"attention_off\"" |
    "\"attention_on\"" |
    "\"background\"" |
    "\"debug\"" |
    "\"delete\"" |
    "\"delete_all\"" |
    "\"discover\"" |
    "\"followup_off\"" |
    "\"followup_on\"" |
    "\"intent_remove_light\"" |
    "\"intent_rename_light\"" |
    "\"intent_set_default_light\"" |
    "\"list\"" |
    "\"list_saved\"" |
    "\"next\"" |
    "\"normal\"" |
    "\"off\"" |
    "\"on\"" |
    "\"pause\"" |
    "\"play\"" |
    "\"prev\"" |
    "\"silent_mode_off\"" |
    "\"silent_mode_on\"" |
    "\"status_full\"" |
    "\"status_playlist\"" |
    "\"status_queue\"" |
    "\"status_track\"" |
    "\"stop\"" |
    "\"toggle\"" |
    "\"toggle_silent_mode\"" |
    "\"volume\""

# String: proper GBNF character class (not regex), used for open-vocabulary fields
string ::= "\"" string-char* "\""
string-char ::= [^"\\] | "\\" ["\\/bfnrt]

# Number: integer or decimal, no grouping
number ::= [0-9]+ number-decimal?
number-decimal ::= "." [0-9]+

# Whitespace
ws ::= [ \t\n\r]*
