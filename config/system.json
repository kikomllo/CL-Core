    "src/clSpotify.py": ["spotify", "music", "audio module"],
    "src/clControl.py": ["control", "lights", "light actuator"],
    "src/clDaemon.py": ["daemon", "brain", "core"],
    "src/clTerminal.py": ["terminal"]
