    "terminal": { "linux": "gnome-terminal", "windows": "wt.exe", "windows_kill": "WindowsTerminal.exe" },
    "discord": { "linux": "/usr/bin/flatpak run --branch=stable --arch=x86_64 com.discordapp.Discord", "linux_kill": "Discord", "windows": "Update.exe --processStart Discord.exe", "windows_kill": "Discord.exe" },
    "spotify": { "linux": "spotify", "windows": "spotify.exe" }
